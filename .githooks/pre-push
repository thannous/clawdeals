#!/bin/sh
# Pre-push hook of the common delivery rule v2 (AGENTS.md). `npm ci` installs
# it: the `prepare` script runs scripts/install-git-hooks.mjs, which sets
# `git config core.hooksPath .githooks`.
#
# A few seconds, no test suite: forbidden files, secrets, file size and the
# .gitignore contract of what the push sends, then whether a proof exists for
# the pushed tree (a missing proof does not block). The suites run before a
# merge with `npm run verify:pr`, on an isolated copy of the commit, so the
# working tree may hold work in progress. Agents never bypass this hook
# (`git push --no-verify`, another core.hooksPath).
if ! command -v node >/dev/null 2>&1; then
  version=""
  [ -r .nvmrc ] && read -r version <.nvmrc
  echo "pre-push: node is not on PATH, so the fast push checks cannot run." >&2
  echo "pre-push: use Node ${version:-from .nvmrc} (\`nvm use\`), then push again." >&2
  exit 1
fi
exec node "$(git rev-parse --show-toplevel)/scripts/verify-local.mjs" hook "$@"
