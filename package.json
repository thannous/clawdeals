{
  "name": "clawdeals",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:smoke": "node scripts/smoke-api.mjs",
    "cron:trustscore": "node scripts/cron-trustscore-recalc.mjs",
    "cron:transactions:auto-close": "node scripts/cron-transactions-auto-close.mjs",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:integration": "playwright test --project=integration",
    "test:e2e:ui": "playwright test --project=ui --ui",
    "test:e2e:headed": "playwright test --project=ui --headed",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test:ci": "npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@upstash/redis": "^1.34.0",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^0.541.0",
    "next": "^16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.16.2",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.1",
    "@types/react": "19.2.13",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.6.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.5.0"
  }
}
