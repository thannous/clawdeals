{
  "name": "clawdeals",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:i18n:contract": "node scripts/validate-i18n-page-contract.mjs",
    "test:i18n:messages": "node scripts/validate-i18n-messages.mjs",
    "openapi:lint": "redocly lint --config .redocly.yaml docs/openapi-v1.yaml",
    "sdk:generate": "npm run sdk:generate:ts && npm run sdk:generate:py",
    "sdk:generate:ts": "node scripts/sdk/generate-typescript-sdk.mjs",
    "sdk:generate:py": "node scripts/sdk/generate-python-sdk.mjs",
    "test:unit": "vitest run",
    "test:smoke": "node scripts/smoke-api.mjs",
    "test:smoke:skill": "node scripts/smoke-skill-examples.mjs",
    "test:skill:pack": "node scripts/validate-skill-pack.mjs",
    "sync:skill:public": "node scripts/sync-skill-public.mjs",
    "test:skill:public": "node scripts/sync-skill-public.mjs --check",
    "mcp:stdio": "node scripts/mcp-server.mjs",
    "mcp:install": "node scripts/mcp/install.mjs",
    "cron:trustscore": "node scripts/cron-trustscore-recalc.mjs",
    "cron:trustscore:queue": "node scripts/cron-trustscore-recalc-queue.mjs",
    "cron:risk-rules": "node scripts/cron-risk-rules.mjs",
    "cron:transactions:auto-close": "node scripts/cron-transactions-auto-close.mjs",
    "cron:notifications:dispatch": "node scripts/cron-notifications-dispatch.mjs",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:integration": "PW_WEB_SERVER_MODE=prod playwright test --project=integration",
    "test:integration:deals": "PW_WEB_SERVER_MODE=prod playwright test --project=integration e2e/integration/deals.api.spec.ts e2e/integration/deal-feed-journey.spec.ts",
    "test:integration:listings": "PW_WEB_SERVER_MODE=prod playwright test --project=integration e2e/integration/listings.spec.ts e2e/integration/listings-update.spec.ts e2e/integration/console-listings-threads-approvals.spec.ts",
    "test:integration:transactions": "PW_WEB_SERVER_MODE=prod playwright test --project=integration e2e/integration/offers.spec.ts e2e/integration/counter-offers.spec.ts e2e/integration/offer-actions.spec.ts e2e/integration/contact-reveal.spec.ts e2e/integration/completion-workflow.spec.ts e2e/integration/ratings.spec.ts e2e/integration/messaging-redaction.spec.ts e2e/integration/approvals.spec.ts e2e/integration/journey-seller-full.spec.ts e2e/integration/journey-buyer-full.spec.ts e2e/integration/journey-budget-approval-counter.spec.ts",
    "test:integration:escrow": "PW_WEB_SERVER_MODE=prod playwright test --project=integration e2e/integration/psp.spec.ts e2e/integration/escrow.spec.ts",
    "test:integration:dispute": "PW_WEB_SERVER_MODE=prod playwright test --project=integration e2e/integration/dispute.spec.ts e2e/integration/evidence.spec.ts",
    "test:e2e:ui": "playwright test --project=ui --ui",
    "test:e2e:headed": "playwright test --project=ui --headed",
    "preview": "npm run preview:cloudflare",
    "preview:cloudflare": "wrangler dev",
    "preview:cloudflare:opennext": "npm run sync:skill:public && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run deploy:cloudflare",
    "deploy:cloudflare": "wrangler deploy",
    "deploy:cloudflare:opennext": "npm run sync:skill:public && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test:ci": "npm run typecheck && npm run test:i18n:contract && npm run test:i18n:messages && npm run openapi:lint && npm run test:unit && npm run test:skill:pack && npm run test:skill:public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@supabase/supabase-js": "^2.49.1",
    "@upstash/redis": "^1.34.0",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^0.541.0",
    "next": "^16.1.6",
    "next-intl": "^4.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.0.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.1.6",
    "@opennextjs/cloudflare": "1.16.2",
    "@playwright/test": "^1.58.1",
    "@redocly/cli": "^2.17.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.1",
    "@types/react": "19.2.13",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.6.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.5.0"
  }
}
