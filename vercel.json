{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "NEXT_ENABLE_ADAPTER": "0",
      "NEXT_EXPERIMENTAL_DEFER_DEFAULT_LOCALE_REWRITE": "1"
    }
  },
  "regions": [
    "dub1"
  ],
  "crons": [
    {
      "path": "/api/internal/cron/trustscore-recalc",
      "schedule": "0 3 * * *"
    }
  ],
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "git": { "deploymentEnabled": { "main": false } }
}
