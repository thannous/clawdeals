{
  "mainBranch": "main",
  "commands": {
    "pr": "npm run verify:pr",
    "release": "npm run verify:release"
  },
  "deps": {
    "mode": "link",
    "lockfile": "package-lock.json",
    "install": "npm ci --prefer-offline --no-audit --no-fund",
    "copy": []
  },
  "setup": [],
  "externalSources": [],
  "deliveryFiles": [
    "eslint.config.mjs",
    "tsconfig.json",
    "vitest.config.ts",
    ".githooks/pre-push",
    "scripts/lint-changed.mjs",
    "scripts/lint-everything.mjs",
    "scripts/verify-sdk.sh",
    "scripts/has-playwright-browser.mjs",
    "scripts/install-git-hooks.mjs",
    "scripts/validate-i18n-page-contract.mjs",
    "scripts/validate-i18n-messages.mjs",
    "scripts/validate-skill-pack.mjs",
    "scripts/sync-skill-public.mjs",
    ".redocly.yaml",
    ".redocly.lint-ignore.yaml",
    "e2e/testerarmy/run-historical.mjs",
    "scripts/lint-migration-grants.mjs",
    "scripts/git-hooks.test.mjs",
    "scripts/verify-local.config.test.mjs",
    "scripts/lint-migration-grants.test.mjs",
    "scripts/check-db-grants.mjs",
    "scripts/check-db-grants.test.mjs"
  ],
  "checks": [
    {
      "name": "engine-tests",
      "command": "node --test scripts/test-verify-local.mjs",
      "inputs": [
        "scripts/verify-local.mjs",
        "scripts/test-verify-local.mjs",
        "verify-local.config.json",
        ".gitattributes"
      ]
    },
    {
      "name": "git-hooks",
      "command": "npm run test:git-hooks",
      "inputs": [
        ".githooks/**",
        ".gitignore",
        "package.json",
        "verify-local.config.json",
        "scripts/verify-local.mjs",
        "scripts/install-git-hooks.mjs",
        "scripts/git-hooks.test.mjs"
      ]
    },
    {
      "name": "verify-config",
      "command": "node --test scripts/verify-local.config.test.mjs",
      "inputs": [
        "verify-local.config.json",
        "scripts/verify-local.mjs",
        "scripts/lint-changed.mjs",
        "scripts/lint-everything.mjs",
        "scripts/verify-local.config.test.mjs"
      ]
    },
    {
      "name": "migration-grants",
      "command": "npm run lint:migration-grants && npm run test:migration-grants",
      "inputs": [
        "supabase/migrations/**",
        "scripts/lint-migration-grants.mjs",
        "scripts/lint-migration-grants.test.mjs",
        "package.json"
      ]
    },
    {
      "name": "db-grants",
      "command": "npm run test:db-grants && npm run check:db-grants",
      "when": [
        "supabase/**",
        "scripts/check-db-grants.mjs",
        "scripts/check-db-grants.test.mjs",
        "package.json"
      ],
      "inputs": [
        "supabase/**",
        "scripts/check-db-grants.mjs",
        "scripts/check-db-grants.test.mjs",
        "package.json"
      ],
      "env": {
        "VERIFY_LOCAL_STEP_GRACE_MS": "30000"
      }
    },
    {
      "name": "lint-changed",
      "perBase": true,
      "command": "npm run lint:changed",
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        "**/*.mjs",
        "**/*.cjs",
        "package.json",
        "eslint.config.mjs",
        "package-lock.json"
      ],
      "when": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        "**/*.mjs",
        "**/*.cjs",
        "eslint.config.mjs",
        "package-lock.json"
      ]
    },
    {
      "name": "typecheck",
      "command": "npm run typecheck",
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.json"
      ],
      "exclude": [
        "verify-local.config.json"
      ]
    },
    {
      "name": "i18n-page-contract",
      "command": "npm run test:i18n:contract",
      "inputs": [
        "src/pages/**",
        "scripts/validate-i18n-page-contract.mjs",
        "package.json"
      ]
    },
    {
      "name": "i18n-messages",
      "command": "npm run test:i18n:messages",
      "inputs": [
        "messages/**",
        "scripts/validate-i18n-messages.mjs",
        "package.json"
      ]
    },
    {
      "name": "openapi-lint",
      "command": "npm run openapi:lint",
      "inputs": [
        "docs/openapi-v1.yaml",
        ".redocly.yaml",
        ".redocly.lint-ignore.yaml",
        "package.json"
      ]
    },
    {
      "name": "skill-pack",
      "command": "npm run test:skill:pack",
      "inputs": [
        "skills/**",
        "public/**",
        "scripts/validate-skill-pack.mjs",
        "package.json"
      ]
    },
    {
      "name": "skill-public",
      "command": "npm run test:skill:public",
      "inputs": [
        "skills/**",
        "public/**",
        "scripts/sync-skill-public.mjs",
        "package.json"
      ]
    },
    {
      "name": "unit",
      "command": "npm run test:unit",
      "exclude": [
        "*.md",
        "docs/**/*.md",
        ".agents/**",
        ".github/**",
        ".githooks/**",
        "competitor-profiles/**",
        "verify-local.config.json",
        "scripts/verify-local.mjs",
        "scripts/test-verify-local.mjs",
        "scripts/install-git-hooks.mjs",
        "scripts/git-hooks.test.mjs",
        "scripts/lint-changed.mjs",
        "scripts/lint-everything.mjs",
        "scripts/verify-local.config.test.mjs",
        "scripts/has-playwright-browser.mjs",
        "scripts/verify-sdk.sh",
        "scripts/lint-migration-grants.mjs",
        "scripts/lint-migration-grants.test.mjs",
        "scripts/check-db-grants.mjs",
        "scripts/check-db-grants.test.mjs"
      ]
    },
    {
      "name": "sdk",
      "command": "sh scripts/verify-sdk.sh",
      "when": [
        "docs/openapi-v1.yaml",
        "scripts/sdk/**",
        "sdk/**",
        "scripts/verify-sdk.sh"
      ],
      "specialised": true,
      "requires": {
        "command": "java -version >/dev/null 2>&1 && python3.11 -c \"import ensurepip, venv\" >/dev/null 2>&1 && curl -sf -o /dev/null --retry 2 --retry-all-errors --max-time 15 https://registry.npmjs.org/ && curl -sf -o /dev/null --retry 2 --retry-all-errors --max-time 15 https://repo1.maven.org/maven2/ && curl -sf -o /dev/null --retry 2 --retry-all-errors --max-time 15 https://pypi.org/simple/pip/",
        "hint": "run it locally where you run verify:pr (it needs Java for OpenAPI Generator, Python 3.11 and access to npm, Maven Central and PyPI); if this machine cannot, say so in the PR. A run on the verified commit can be cited with --external sdk=\"owner-machine: <host> <note> on <SHA>\""
      }
    },
    {
      "name": "lint",
      "command": "npm run lint",
      "kinds": [
        "release"
      ],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        "**/*.mjs",
        "**/*.cjs",
        "package.json",
        "eslint.config.mjs",
        "package-lock.json"
      ]
    },
    {
      "name": "build",
      "command": "npm run build",
      "kinds": [
        "release"
      ],
      "install": true,
      "exclude": [
        "*.md",
        "docs/**/*.md",
        ".agents/**",
        ".github/**",
        ".githooks/**",
        "competitor-profiles/**",
        "verify-local.config.json",
        "scripts/verify-local.mjs",
        "scripts/test-verify-local.mjs",
        "scripts/install-git-hooks.mjs",
        "scripts/git-hooks.test.mjs",
        "scripts/lint-changed.mjs",
        "scripts/lint-everything.mjs",
        "scripts/verify-local.config.test.mjs",
        "scripts/has-playwright-browser.mjs",
        "scripts/verify-sdk.sh",
        "scripts/lint-migration-grants.mjs",
        "scripts/lint-migration-grants.test.mjs",
        "scripts/check-db-grants.mjs",
        "scripts/check-db-grants.test.mjs"
      ],
      "env": {
        "NEXT_TELEMETRY_DISABLED": "1"
      }
    },
    {
      "name": "worker-bundle",
      "command": "npm exec -- wrangler deploy --dry-run --outdir .wrangler/verify-local-bundle",
      "kinds": [
        "release"
      ],
      "inputs": [
        "workers/**",
        "src/**",
        "packages/**",
        "wrangler.jsonc",
        "tsconfig.json",
        "package.json"
      ],
      "env": {
        "WRANGLER_SEND_METRICS": "false"
      }
    },
    {
      "name": "historical-corpus",
      "command": "out=\".e2e/runs/historical/verify-local-$VERIFY_LOCAL_SHA\"; PARITY_OUTPUT=\"$out\" node e2e/testerarmy/run-historical.mjs run; status=$?; kept=\"$VERIFY_LOCAL_ROOT/.e2e/verify-local/historical-$VERIFY_LOCAL_SHA\"; rm -rf \"$kept\" && mkdir -p \"$kept\" && cp -R \"$out/.\" \"$kept/\" && echo \"historical-corpus: evidence in $kept\"; exit $status",
      "kinds": [
        "release"
      ],
      "specialised": true,
      "exclude": [
        "*.md",
        "docs/**/*.md",
        ".agents/**",
        ".github/**",
        ".githooks/**",
        "competitor-profiles/**",
        "verify-local.config.json",
        "scripts/verify-local.mjs",
        "scripts/test-verify-local.mjs",
        "scripts/install-git-hooks.mjs",
        "scripts/git-hooks.test.mjs",
        "scripts/lint-changed.mjs",
        "scripts/lint-everything.mjs",
        "scripts/verify-local.config.test.mjs",
        "scripts/has-playwright-browser.mjs",
        "scripts/verify-sdk.sh",
        "scripts/lint-migration-grants.mjs",
        "scripts/lint-migration-grants.test.mjs",
        "scripts/check-db-grants.mjs",
        "scripts/check-db-grants.test.mjs"
      ],
      "env": {
        "E2E_TELEMETRY_DISABLED": "1",
        "NEXT_TELEMETRY_DISABLED": "1",
        "TESTERARMY_AI": "0"
      },
      "requires": {
        "command": "node scripts/has-playwright-browser.mjs",
        "hint": "run it locally where you run verify:pr (it needs the Chromium pinned by playwright-core: `npx playwright install chromium`); if this machine cannot, say so in the PR. A run on the verified commit can be cited with --external historical-corpus=\"owner-machine: <host> <note> on <SHA>\""
      }
    }
  ],
  "hook": {
    "checks": [
      "gitignore-env"
    ]
  },
  "ENGINE_SHA256": "e5b1bd66a558f801d6af04c6ec72561cdb70abc221f05d3f1fd688d0caf4a576"
}
