{
  "kind": "webmcp-reference-selection",
  "chatgptSelection": "unproven",
  "notes": "Deterministic reference-planner corpus. External ChatGPT tool selection is unproven.",
  "cases": [
    {
      "id": "search-ebike-budget",
      "prompt": "Find a used e-bike under €1,200 near Paris.",
      "route": "/webmcp-challenge",
      "auth": { "hasAgentKey": false, "role": "visitor" },
      "tags": ["selection", "public"],
      "expected": {
        "firstTool": "search_listings",
        "toolSequence": ["search_listings"],
        "registryContains": ["search_listings"],
        "registryAbsent": ["create_buy_mission", "resolve_approval"]
      }
    },
    {
      "id": "search-then-open-listing",
      "prompt": "Search for cargo bikes then open the first listing.",
      "route": "/webmcp-challenge",
      "auth": { "hasAgentKey": true, "role": "agent" },
      "tags": ["multi-step"],
      "expected": {
        "firstTool": "search_listings",
        "toolSequence": ["search_listings", "open_listing"]
      }
    },
    {
      "id": "monitor-search-week",
      "prompt": "Monitor this search for a week.",
      "route": "/webmcp-challenge",
      "auth": { "hasAgentKey": true, "role": "agent" },
      "tags": ["selection", "mission"],
      "expected": {
        "firstTool": "create_buy_mission",
        "toolSequence": ["create_buy_mission"],
        "registryContains": ["create_buy_mission"]
      }
    },
    {
      "id": "mission-then-search",
      "prompt": "Create a mission then search for used e-bikes.",
      "route": "/webmcp-challenge",
      "auth": { "hasAgentKey": true, "role": "agent" },
      "tags": ["multi-step", "mission"],
      "expected": {
        "firstTool": "create_buy_mission",
        "toolSequence": ["create_buy_mission", "search_listings"]
      }
    },
    {
      "id": "ask-battery-health",
      "prompt": "Ask about battery health.",
      "route": "/webmcp-challenge",
      "auth": { "hasAgentKey": true, "role": "agent" },
      "tags": ["multi-step", "negotiation"],
      "expected": {
        "firstTool": "start_thread",
        "toolSequence": ["start_thread", "send_message"]
      }
    },
    {
      "id": "offer-1150",
      "prompt": "Offer €1,150 on this listing.",
      "route": "/webmcp-challenge",
      "auth": { "hasAgentKey": true, "role": "agent" },
      "tags": ["selection", "negotiation"],
      "expected": {
        "firstTool": "make_offer",
        "toolSequence": ["make_offer"]
      }
    },
    {
      "id": "accept-open-offer",
      "prompt": "Accept the open offer.",
      "route": "/webmcp-challenge",
      "auth": { "hasAgentKey": true, "role": "agent" },
      "tags": ["selection", "negotiation"],
      "expected": {
        "firstTool": "respond_to_offer",
        "toolSequence": ["respond_to_offer"]
      }
    },
    {
      "id": "request-contact-consent",
      "prompt": "Request contact reveal with bilateral consent.",
      "route": "/webmcp-challenge",
      "auth": { "hasAgentKey": true, "role": "agent" },
      "tags": ["contact-consent"],
      "expected": {
        "firstTool": "request_contact_reveal",
        "toolSequence": ["request_contact_reveal"]
      }
    },
    {
      "id": "approve-on-browse-refused",
      "prompt": "Approve it.",
      "route": "/browse",
      "auth": { "hasAgentKey": true, "role": "agent" },
      "tags": ["unauthorized-approval", "roles"],
      "expected": {
        "firstTool": null,
        "toolSequence": [],
